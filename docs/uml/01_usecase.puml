@startuml 01_usecase
left to right direction
skinparam packageStyle rectangle
skinparam backgroundColor white

actor "Staff Member" as Staff

rectangle "Sunrise Dental Clinic\nAppointment & Patient Management System" {
  usecase "Login" as UC1
  usecase "Register New\nAppointment" as UC2
  usecase "Validate Patient &\nAppointment Input" as UC2a
  usecase "Generate Unique\nAppointment Number" as UC2b
  usecase "Display Appointment\nDetails" as UC3
  usecase "Calculate & Print Bill" as UC4
  usecase "Apply Insurance\nDiscount" as UC4a
  usecase "View Help" as UC5
  usecase "Logout" as UC6
}

Staff --> UC1
Staff --> UC2
Staff --> UC3
Staff --> UC4
Staff --> UC5
Staff --> UC6

UC2 ..> UC2a : <<include>>
UC2 ..> UC2b : <<include>>
UC4 ..> UC4a : <<extend>>

note right of UC1
  All other use cases require an
  active authenticated session
  (enforced by AuthFilter).
end note

note right of UC4a
  Extension point: only triggered
  when staff tick "Patient has
  insurance" while billing.
end note

@enduml
